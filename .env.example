# Mandatory: generate with python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Container locations (not host filesystem paths)
COURSES_ROOT=/app/courses
DATABASE_PATH=/app/data/cursos.sqlite3

# Traefik serves HTTPS. Set false ONLY if developing over HTTP on localhost.
COOKIE_SECURE=true

# Controls whether the top-right profile menu offers self-service signup.
# Browsing/guest progress NEVER requires registration, regardless of this value.
ALLOW_REGISTRATION=true

# Optional: max seconds for first-time Word/PowerPoint/Excel to PDF conversion
OFFICE_CONVERT_TIMEOUT=90

# Optional homepage meme card (enabled by default).
MEMES_ENABLED=true
# Directory path INSIDE the container. Bundled memes live in /app/memes.
MEMES_DIR=/app/memes

# Optional: Authentik OIDC SSO for Cursos.
# In Authentik create an OAuth2/OpenID Connect application with slug 'cursos'.
# Register https://cursos.esquema.qzz.io/auth/oidc/callback as a STRICT Authorization redirect URI.
# OIDC_DISCOVERY_URL=https://tik.esquema.qzz.io/application/o/cursos/.well-known/openid-configuration
# Optional internal Docker-network transport. Set BOTH values to access Authentik
# over its internal HTTP IP, while public OAuth redirects and issuer stay HTTPS.
# OIDC_DISCOVERY_URL=http://172.27.0.19:9000/application/o/cursos/.well-known/openid-configuration
# OIDC_HOST=tik.esquema.qzz.io
# OIDC_CLIENT_ID=YOUR_AUTHENTIK_CLIENT_ID
# OIDC_CLIENT_SECRET=YOUR_AUTHENTIK_CLIENT_SECRET
# OIDC_REDIRECT_URI=https://cursos.esquema.qzz.io/auth/oidc/callback
# Optional OIDC group restriction; omit for any authenticated Authentik user.
# OIDC_REQUIRED_GROUP=sqm-family
